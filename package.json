{
  "name": "edxr-app-banner",
  "version": "0.1.0",
  "description": "Platform-aware get-the-app banner for EducationXR web properties",
  "repository": "github:heizenrader/edxr-app-banner",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
